# Every value here is server-only. Never add a NEXT_PUBLIC_ prefix to a
# credential: Next.js inlines those into the client bundle at build time, which
# publishes the secret irreversibly. `npm run verify:env` fails the build if one
# appears. See README § Data access and secrets for rotation steps.

# Server-only Postgres connection string from Supabase (use the session pooler).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# Server-only Supabase project URL used by later authentication stories.
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Server-only Supabase anon (publishable) key — used for magic-link / session cookies.
SUPABASE_ANON_KEY=

# Server-only Supabase service-role key (admin). Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical app origin used in magic-link callbacks (no trailing path).
SITE_URL=http://localhost:3000

# Local development defaults to Gemini; production will default to Anthropic.
LLM_PROVIDER=gemini

# Optional model overrides (defaults: gemini-flash-latest, claude-sonnet-4-6).
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Conversation + crop-draft spend (ALL-15). Paid Anthropic credits only.
# LLM_MONTHLY_CAP_USD=100
# LLM_DAILY_QA_LIMIT=20
# LLM_ALERT_THRESHOLDS=50,80

# Optional conversation / crop-draft spend caps (ALL-15). Paid Anthropic only.
# LLM_MONTHLY_CAP_USD=100
# LLM_DAILY_QA_LIMIT=20
# LLM_ALERT_THRESHOLDS=50,80

# Server-only model provider credentials.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Server-only Gmail SMTP app password for recommendation emails.
GMAIL_APP_PASSWORD=

# Server-only bearer secret used to authorize scheduled check-ins.
CRON_SECRET=

# Comma-separated email allowlist for the two household members.
ALLOWED_EMAILS=allison@example.com,partner@example.com
